# Application Configuration
APP_NAME=Mentra
APP_ENV=development
VERSION=0.1.0
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://mentra:mentra@localhost:5432/mentra

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=replace_with_a_secure_jwt_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated or wildcard for dev)
CORS_ORIGINS=*

# AI Coach Provider Configuration ("auto", "openai", "gemini", or "heuristic")
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
